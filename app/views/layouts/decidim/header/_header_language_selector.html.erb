<% if available_locales.length > 1 %>
  <div class="main-bar__dropdown-container">
    <button id="trigger-dropdown-language-chooser-header"
            type="button"
            class="main-bar__dropdown-trigger"
            data-controller="dropdown"
            data-target="dropdown-menu-language-chooser-header"
            aria-label="<%= t("layouts.decidim.language_chooser.choose_language") %>">
      <%= icon "global-line" %>
      <span><%= t("name", scope: "locale") %></span>
      <%= icon "arrow-down-s-line" %>
      <span class="sr-only">
        <% available_locales.each do |locale| %>
          <span lang="<%= locale %>">
            <%= I18n.with_locale(locale) { t("layouts.decidim.language_chooser.choose_language") } %>
          </span>
        <% end %>
      </span>
    </button>

    <div id="dropdown-menu-language-chooser-header" aria-hidden="true">
      <ul class="dropdown dropdown__bottom" role="menu">
        <% (available_locales - [I18n.locale.to_s]).each do |locale| %>
          <li class="dropdown__item" role="presentation">
            <%= link_to decidim.locale_path(locale:), method: :post, role: "menuitem", lang: locale, class: "dropdown__button" do %>
              <span><%= locale_name(locale) %></span>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
